{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NasUmaev/aurora-bridges/knowledge-schema/article-v2.schema.json",
  "title": "Aurora knowledge article v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "gameVersion",
    "title",
    "aliases",
    "tags",
    "subject",
    "summary",
    "facts",
    "relations",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9._@-]{1,128}$" },
    "kind": {
      "enum": [
        "block",
        "item",
        "mob",
        "recipe",
        "drop",
        "enchantment",
        "effect",
        "biome",
        "structure",
        "mechanic",
        "guide"
      ]
    },
    "gameVersion": { "const": "1.7.10" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "aliases": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "registryName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "numericId": { "type": "integer", "minimum": 0 },
        "metadata": { "type": "integer", "minimum": 0 },
        "variant": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "text", "sourceIds"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9._-]{1,80}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "conditions": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9._-]{1,80}$" }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z0-9._-]{1,80}$" },
          "target": { "type": "string", "minLength": 1, "maxLength": 160 },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,80}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "type": {
            "enum": ["game-code", "game-data", "official-wiki", "release-notes", "manual-verification"]
          },
          "reference": { "type": "string", "maxLength": 500 },
          "url": { "type": "string", "format": "uri", "maxLength": 1000 }
        }
      }
    }
  }
}
